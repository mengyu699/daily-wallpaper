# WeChat Database Path
# macOS: ~/Library/Containers/com.tencent.xinWeChat/Data/Library/Application Support/com.tencent.xinWeChat/*/Message/*.db
# Windows: C:\Users\%USERNAME%\Documents\WeChat Files\wxid_*\Msg\MicroMsg.db
WECHAT_DB_PATH=/path/to/your/wechat/database.db

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/wechat

# AI Service API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
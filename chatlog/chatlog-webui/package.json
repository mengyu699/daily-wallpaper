{
  "name": "chatlog-webui",
  "version": "2.0.0",
  "description": "微信聊天记录WebUI分析系统 - 生产级重构版本",
  "main": "app-new.js",
  "scripts": {
    "start": "node app-new.js",
    "start:prod": "NODE_ENV=production node app-new.js",
    "dev": "NODE_ENV=development nodemon app-new.js",
    "test": "jest --coverage --passWithNoTests",
    "test:unit": "jest --testPathPattern=tests/unit --coverage",
    "test:integration": "jest --testPathPattern=tests/integration --coverage",
    "test:e2e": "jest --testPathPattern=tests/e2e --coverage",
    "test:watch": "jest --watch",
    "test:watch:unit": "jest --testPathPattern=tests/unit --watch",
    "test:ci": "jest --coverage --ci --watchAll=false --passWithNoTests",
    "test:debug": "jest --testPathPattern=tests/unit --detectOpenHandles --verbose",
    "test:real-chatlog": "TEST_WITH_REAL_CHATLOG=true jest --testPathPattern=tests/integration/services.test.js",
    "test:real-ai": "TEST_WITH_REAL_AI=true jest --testPathPattern=tests/integration/services.test.js",
    "lint": "eslint . --ext .js --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .js --ignore-path .gitignore --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "security:audit": "npm audit",
    "security:check": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "build": "npm run lint && npm run test:ci && npm run security:check",
    "build:prod": "NODE_ENV=production npm run build",
    "precommit": "npm run lint && npm run test:unit",
    "prepare": "husky install || true",
    "health:check": "curl -f http://localhost:3000/health || exit 1",
    "typecheck": "echo 'TypeScript checking not configured'",
    "validate": "npm run lint && npm run test:unit && npm run security:check"
  },
  "keywords": ["wechat", "chatlog", "analysis", "ai"],
  "author": "mengyu",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ejs": "^3.1.9",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "axios": "^1.6.2",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.6",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "express-session": "^1.17.3",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "express-validator": "^7.0.1",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.5",
    "jest-watch-typeahead": "^2.2.2",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.1.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "babel-jest": "^29.7.0",
    "nock": "^13.4.0",
    "sinon": "^17.0.1"
  }
}

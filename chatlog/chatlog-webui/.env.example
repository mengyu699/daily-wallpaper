# Environment Variables Template
# Copy this file to .env and fill in your values

# 应用配置
NODE_ENV=development
PORT=3000

# 会话和认证配置
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-environment
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-environment

# 默认管理员配置（首次启动时创建）
DEFAULT_ADMIN_PASSWORD=Admin123!@#

# DeepSeek AI API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Chatlog API配置
CHATLOG_API_BASE=http://localhost:8080/api/v1
CHATLOG_TIMEOUT=15000

# 服务器配置
SERVER_HOST=0.0.0.0
REQUEST_TIMEOUT=30000

# 安全和限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
API_RATE_LIMIT_MAX=200
AI_RATE_LIMIT_MAX=20

# 身份验证配置
AUTH_TOKEN_EXPIRY=24h
AUTH_SESSION_TIMEOUT=8h
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=30m

# 用户管理配置
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_MIN_LENGTH=8

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_FILE_ENABLED=true
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# 开发环境配置
DEV_MOCK_CHATLOG=false
DEV_MOCK_AI=false
DEV_DEBUG_MODE=true

# 测试环境配置
TEST_WITH_REAL_CHATLOG=false
TEST_WITH_REAL_AI=false

# 数据存储配置
DATA_DIR=./data
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h

# 监控配置
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PERFORMANCE_MONITORING=true
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - 微信聊天记录分析系统</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-chat-dots-fill me-2"></i>
                微信聊天分析系统
            </a>
            
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">
                    <i class="bi bi-house"></i> 返回首页
                </a>
            </div>
        </div>
    </nav>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
                <div class="error-container">
                    <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 5rem;"></i>
                    
                    <h1 class="display-4 mt-4 mb-3">
                        <%= error.status || 500 %>
                    </h1>
                    
                    <h2 class="h4 text-muted mb-4">
                        <%= title || '出现错误' %>
                    </h2>
                    
                    <p class="lead text-muted mb-4">
                        <%= message || '服务器遇到了一个错误，请稍后重试。' %>
                    </p>
                    
                    <div class="d-flex justify-content-center gap-3">
                        <a href="/" class="btn btn-primary">
                            <i class="bi bi-house me-2"></i>返回首页
                        </a>
                        <button onclick="history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>返回上页
                        </button>
                        <button onclick="window.location.reload()" class="btn btn-outline-info">
                            <i class="bi bi-arrow-clockwise me-2"></i>重新加载
                        </button>
                    </div>
                    
                    <% if (process.env.NODE_ENV === 'development' && error.stack) { %>
                    <div class="mt-5">
                        <details class="text-start">
                            <summary class="btn btn-sm btn-outline-danger mb-3">查看详细错误信息</summary>
                            <pre class="bg-light p-3 rounded text-danger small"><%= error.stack %></pre>
                        </details>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - 微信聊天记录分析系统</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-chat-dots-fill me-2"></i>
                微信聊天分析系统
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house"></i> 首页
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/search">
                            <i class="bi bi-search"></i> 搜索
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/contacts">
                            <i class="bi bi-people"></i> 联系人
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/analysis">
                            <i class="bi bi-graph-up"></i> AI分析
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>
                        <i class="bi bi-people-fill text-primary me-2"></i>
                        <%= title %>
                    </h2>
                    <div class="badge bg-primary fs-6">
                        总计 <%= total %> 个联系人
                    </div>
                </div>

                <% if (contacts && contacts.length > 0) { %>
                    <div class="row">
                        <% contacts.forEach((contact, index) => { %>
                            <div class="col-md-6 col-lg-4 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="card-title mb-1">
                                                    <%= contact.nickname || contact.username || '未知' %>
                                                </h6>
                                                <p class="card-text text-muted small mb-1">
                                                    <i class="bi bi-at"></i>
                                                    <%= contact.username || contact.id %>
                                                </p>
                                                <% if (contact.remark) { %>
                                                <p class="card-text text-muted small mb-1">
                                                    <i class="bi bi-tag"></i>
                                                    <%= contact.remark %>
                                                </p>
                                                <% } %>
                                                <% if (contact.messageCount) { %>
                                                <p class="card-text text-muted small">
                                                    <i class="bi bi-chat"></i>
                                                    <%= contact.messageCount %> 条消息
                                                </p>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-person-x display-1 text-muted"></i>
                        <h4 class="text-muted mt-3">暂无联系人数据</h4>
                        <p class="text-muted">请确保Chatlog服务正在运行并包含数据</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>